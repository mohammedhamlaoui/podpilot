# PodPilot backend production environment example.
# Copy this file on the server only. Do not commit real secret values.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=podpilot-files
R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_SIGNED_URL_TTL_SECONDS=3600

CDN_BASE_URL=https://cdn.podpilot.space
CDN_SIGNING_SECRET=YOUR_LONG_RANDOM_CDN_SIGNING_SECRET
CDN_URL_TTL_SECONDS=1800

RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
REDIS_URL=
DEBUG=false

ALLOWED_ORIGINS=https://podpilot.space

# Separate Owner-only Admin HQ. Keep this exact; do not use a wildcard origin.
ADMIN_APP_ORIGIN=https://admin.podpilot.space
ADMIN_REQUIRE_MFA=true
ADMIN_SESSION_IDLE_MINUTES=20
ADMIN_SESSION_ABSOLUTE_HOURS=8
ADMIN_REAUTH_MAX_AGE_SECONDS=300
ADMIN_COOKIE_SECURE=true
PUBLIC_APP_URL=https://podpilot.space

AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

AI_LISTING_PROVIDER=openrouter
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=rekaai/reka-edge
# Optional emergency fallback used only after the normal AI Listing providers fail.
ENABLE_OPENROUTER_FREE_FALLBACK=true
OPENROUTER_FREE_FALLBACK_MODEL=openrouter/free
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

PADDLE_ENVIRONMENT=production
PADDLE_API_KEY=YOUR_PADDLE_API_KEY
PADDLE_WEBHOOK_SECRET=YOUR_PADDLE_WEBHOOK_SECRET_AFTER_WEBHOOK_CREATION

# Historical aliases for existing subscriptions only. Never use these for new checkouts.
PADDLE_REDBUBBLE_PRICE_ID=
PADDLE_TEEPUBLIC_PRICE_ID=
PADDLE_ALL_PLATFORMS_PRICE_ID=
PADDLE_REDBUBBLE_PAID_PRICE_ID=
PADDLE_TEEPUBLIC_PAID_PRICE_ID=
PADDLE_ALL_PLATFORMS_PAID_PRICE_ID=

# Optional historical trial IDs for webhook and billing history interpretation.
PADDLE_REDBUBBLE_MONTHLY_TRIAL_PRICE_ID=
PADDLE_TEEPUBLIC_MONTHLY_TRIAL_PRICE_ID=
PADDLE_ALL_PLATFORMS_MONTHLY_TRIAL_PRICE_ID=
PADDLE_REDBUBBLE_ANNUAL_TRIAL_PRICE_ID=
PADDLE_TEEPUBLIC_ANNUAL_TRIAL_PRICE_ID=
PADDLE_ALL_PLATFORMS_ANNUAL_TRIAL_PRICE_ID=

# New paid subscription prices. Verify amounts, USD currency, billing cycles,
# active status, and trial_period=null in Paddle before setting these IDs.
PADDLE_REDBUBBLE_MONTHLY_PRICE_ID=YOUR_REDBUBBLE_MONTHLY_PRICE_ID
PADDLE_TEEPUBLIC_MONTHLY_PRICE_ID=YOUR_TEEPUBLIC_MONTHLY_PRICE_ID
PADDLE_ALL_PLATFORMS_MONTHLY_PRICE_ID=YOUR_ALL_PLATFORMS_MONTHLY_PRICE_ID
PADDLE_REDBUBBLE_ANNUAL_PRICE_ID=YOUR_REDBUBBLE_ANNUAL_PRICE_ID
PADDLE_TEEPUBLIC_ANNUAL_PRICE_ID=YOUR_TEEPUBLIC_ANNUAL_PRICE_ID
PADDLE_ALL_PLATFORMS_ANNUAL_PRICE_ID=YOUR_ALL_PLATFORMS_ANNUAL_PRICE_ID

# Map old paid subscription IDs so existing customers keep their old billing display.
PADDLE_LEGACY_REDBUBBLE_MONTHLY_PRICE_ID=
PADDLE_LEGACY_REDBUBBLE_ANNUAL_PRICE_ID=
PADDLE_LEGACY_TEEPUBLIC_MONTHLY_PRICE_ID=
PADDLE_LEGACY_TEEPUBLIC_ANNUAL_PRICE_ID=
PADDLE_LEGACY_ALL_PLATFORMS_MONTHLY_PRICE_ID=
PADDLE_LEGACY_ALL_PLATFORMS_ANNUAL_PRICE_ID=

# One-time AI listing credit pack prices. These never use a trial.
PADDLE_AI_TOKENS_250_PRICE_ID=YOUR_AI_TOKENS_250_PRICE_ID
PADDLE_AI_TOKENS_500_PRICE_ID=YOUR_AI_TOKENS_500_PRICE_ID
PADDLE_AI_TOKENS_1000_PRICE_ID=YOUR_AI_TOKENS_1000_PRICE_ID
PADDLE_AI_TOKENS_2500_PRICE_ID=YOUR_AI_TOKENS_2500_PRICE_ID
PADDLE_AI_TOKENS_5000_PRICE_ID=YOUR_AI_TOKENS_5000_PRICE_ID
PADDLE_AI_TOKENS_10000_PRICE_ID=YOUR_AI_TOKENS_10000_PRICE_ID

# Historical trial hashes remain in the database; no new trials are offered.

TRADEMARK_API_PROVIDER=markerapi
MARKERAPI_USERNAME=YOUR_MARKERAPI_USERNAME
MARKERAPI_PASSWORD=YOUR_MARKERAPI_PASSWORD_OR_API_KEY
MARKERAPI_WEBSITE=https://podpilot.space
MARKERAPI_BASE_URL=https://dev.markerapi.com/api/v2
TRADEMARK_PROVIDER=
TRADEMARK_API_USERNAME=
TRADEMARK_API_PASSWORD=
TRADEMARK_API_KEY=
TRADEMARK_API_WEBSITE=

ADMIN_CLEANUP_SECRET=YOUR_LONG_RANDOM_ADMIN_CLEANUP_SECRET

EMAIL_BLOCK_DISPOSABLE=true
EMAIL_VERIFICATION_PROVIDER=
EMAIL_VERIFICATION_API_KEY=
EMAIL_REQUIRE_MX_CHECK=false
