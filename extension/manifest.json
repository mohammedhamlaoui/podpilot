{
  "manifest_version": 3,
  "name": "PodPilot",
  "version": "0.2.3",
  "key": "",
  "description": "Multi-user PodPilot upload automation for Redbubble + TeePublic.",
  "permissions": ["storage", "tabs", "scripting", "activeTab", "notifications", "offscreen", "contextMenus"],
  "host_permissions": [
    "https://www.redbubble.com/*",
    "https://*.redbubble.net/*",
    "https://www.teepublic.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*.supabase.co/*",
    "https://*.r2.cloudflarestorage.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://podpilot.space/*",
      "https://www.podpilot.space/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.redbubble.com/portfolio/images/*/duplicate*",
        "https://www.redbubble.com/portfolio/images/new*",
        "https://www.redbubble.com/studio/promote/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.teepublic.com/*"
      ],
      "js": ["content-teepublic.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PodPilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/cha-ching.mp3", "icons/icon48.png", "icons/icon128.png", "icons/redbubble.svg", "icons/teepublic.svg"],
      "matches": ["https://www.redbubble.com/*", "https://www.teepublic.com/*"]
    }
  ]
}
